{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.seojaehong/k-labor",
  "title": "노동 업무 도구 (k-labor)",
  "description": "Korean labor tools: NHIS report forms, employment contracts, wage/leave/tax calculators, work rules.",
  "repository": {
    "url": "https://github.com/seojaehong/labor-law-guide",
    "source": "github",
    "subfolder": "tools/k-labor"
  },
  "websiteUrl": "https://yellowenvelope.kr/ai-tools",
  "version": "0.1.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "k-labor",
      "version": "0.1.1",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        { "name": "LLG_MCP_GROUPS", "description": "켤 묶음(쉼표 구분: nhis, popbill, contract, calc, leave, tax, duties, work-rules). 비우면 전부", "isRequired": false },
        { "name": "LAW_OC", "description": "법제처 국가법령정보 Open API 이용자 ID(OC). 없으면 work-rules 는 묶은 자료로만 답합니다", "isRequired": false },
        { "name": "POPBILL_LINK_ID", "description": "팩스·문자용 본인 팝빌 링크아이디", "isRequired": false },
        { "name": "POPBILL_SECRET_KEY", "description": "팩스·문자용 본인 팝빌 비밀키", "isRequired": false, "isSecret": true },
        { "name": "POPBILL_CORP_NUM", "description": "팝빌에 가입한 사업자등록번호(숫자 10자리)", "isRequired": false },
        { "name": "POPBILL_FAX_SENDER", "description": "팝빌에 등록한 팩스 발신번호", "isRequired": false },
        { "name": "POPBILL_SMS_SENDER", "description": "팝빌에 등록한 문자 발신번호", "isRequired": false },
        { "name": "POPBILL_IS_TEST", "description": "기본 true(팝빌 테스트환경). 운영환경은 false", "isRequired": false, "default": "true" }
      ]
    }
  ]
}
