{
  "//": "k-labor/office 라이브러리 입구의 타입 선언(d.ts)만 뽑는다. build.mjs 가 --outDir 을 주고 부른다.",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "rootDir": "../../src/lib/office",
